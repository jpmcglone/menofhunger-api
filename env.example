NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/menofhunger?schema=public

# Redis (BullMQ queue for background jobs / workers)
REDIS_URL=redis://localhost:6379

# Process roles (useful when splitting API vs worker services later)
# - API-only service: RUN_HTTP=true, RUN_SCHEDULERS=true, RUN_JOB_CONSUMERS=false
# - Worker-only service: RUN_HTTP=false, RUN_SCHEDULERS=false (or true on exactly one instance), RUN_JOB_CONSUMERS=true
RUN_HTTP=true
RUN_SCHEDULERS=true
RUN_JOB_CONSUMERS=true

# Docker compose (optional): host port for local Postgres container.
# Defaults to 5432; set to 5433 if you already have Postgres on 5432.
# POSTGRES_PORT=5432

# Web origins allowed to call the API with cookies (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# Auth secrets (required in production; recommended everywhere)
OTP_HMAC_SECRET=dev-otp-secret-change-me
SESSION_HMAC_SECRET=dev-session-secret-change-me

# Cookie domain (production suggested: .menofhunger.com)
# COOKIE_DOMAIN=.menofhunger.com

# Dev-only: set true to disable Twilio SMS sending (use 000000 bypass).
# DISABLE_TWILIO_IN_DEV=true

# Twilio (production only)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=        # Twilio Verify Service SID (starts with VA...)
# TWILIO_FROM_NUMBER=               # optional if using messaging service (E.164, e.g. +16319436889)
# TWILIO_MESSAGING_SERVICE_SID=     # optional alternative to TWILIO_FROM_NUMBER (starts with MG...)

# Cloudflare R2 (public assets: avatars/banners)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=               # use your own asset host in production (not *.r2.dev) so images survive spam filters

# Giphy (server-side proxy for GIF search)
# GIPHY_API_KEY=ddms51QMkwXXSvnuoksrURBytHig8CDO

# Global API rate limiting (generous defaults if unset).
# RATE_LIMIT_TTL_SECONDS=60
# RATE_LIMIT_LIMIT=600

# Route-specific throttles (optional)
# RATE_LIMIT_AUTH_START_TTL_SECONDS=60
# RATE_LIMIT_AUTH_START_LIMIT=8
# RATE_LIMIT_AUTH_VERIFY_TTL_SECONDS=60
# RATE_LIMIT_AUTH_VERIFY_LIMIT=20
# RATE_LIMIT_POST_CREATE_TTL_SECONDS=60
# RATE_LIMIT_POST_CREATE_LIMIT=30
# RATE_LIMIT_INTERACT_TTL_SECONDS=60
# RATE_LIMIT_INTERACT_LIMIT=180
# RATE_LIMIT_UPLOAD_TTL_SECONDS=60
# RATE_LIMIT_UPLOAD_LIMIT=60

# Reverse proxy (Render, etc): trust X-Forwarded-* for req.ip / req.protocol.
# TRUST_PROXY=true

# Body size limits (protect memory; uploads have separate limits).
# BODY_JSON_LIMIT=1mb
# BODY_URLENCODED_LIMIT=25kb

# CSRF hardening (cookie auth): in production, require Origin/Referer on unsafe methods.
# REQUIRE_CSRF_ORIGIN_IN_PROD=true

# Dev-only: log each request (useful for debugging).
# LOG_REQUESTS=true

# Dev-only: print a startup config summary.
# LOG_STARTUP_INFO=true

# Presence: minutes with no activity ping before marking user idle (default 3).
# PRESENCE_IDLE_AFTER_MINUTES=3
# Presence: if user stays idle this many minutes, disconnect them (default 15).
# PRESENCE_IDLE_DISCONNECT_MINUTES=15

# Web Push (browser notifications). Generate once: npx web-push generate-vapid-keys
# If unset, push subscription endpoints are stored but no push is sent.
# Same public key must be set as NUXT_PUBLIC_VAPID_PUBLIC_KEY in menofhunger-www.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# APNs (iOS push notifications). All four must be set in production for TestFlight/App Store pushes.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=com.menofhunger.app

# Base URL for push notification click-through (canonical frontend). If unset, first ALLOWED_ORIGINS entry is used.
# Set this in production so notification clicks open the correct origin (e.g. https://menofhunger.com).
# PUSH_FRONTEND_BASE_URL=

# Stripe billing (Premium / Premium+ subscriptions)
# All four keys must be set (plus ALLOWED_ORIGINS or PUSH_FRONTEND_BASE_URL) to enable billing.
# For local dev, use test-mode keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=                # e.g. sk_test_... (test) or sk_live_... (production)
# STRIPE_WEBHOOK_SECRET=            # e.g. whsec_... (from Stripe CLI: `stripe listen --forward-to ...`)
# STRIPE_PRICE_PREMIUM_MONTHLY=     # Price ID from Stripe dashboard (e.g. price_...)
# STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=# Price ID from Stripe dashboard (e.g. price_...)

# DM calling (WebRTC). Media is browser-to-browser; the API only relays signaling.
# STUN defaults to Google's public servers. Prefer Cloudflare Realtime TURN (mints
# short-lived credentials on start/join). Static RTC_TURN_* is a fallback provider.
# RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=
# RTC_TURN_URLS=                    # comma-separated, e.g. turn:turn.example.com:3478?transport=udp
# RTC_TURN_USERNAME=
# RTC_TURN_CREDENTIAL=

# Email (optional): Resend (digests + verification + re-engagement)
# In Resend: verify menofhunger.com (SPF + DKIM + DMARC) and set a custom return-path
# on that same domain. Do not send production mail from *.resend.app.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=                # fallback sender for all emails
# RESEND_FROM_NOTIFICATIONS_EMAIL=  # e.g. "Men of Hunger <notifications@menofhunger.com>"
# RESEND_FROM_SUPPORT_EMAIL=        # e.g. "Men of Hunger <support@menofhunger.com>"
# RESEND_FROM_NEWSLETTER_EMAIL=     # e.g. "Men of Hunger <letters@menofhunger.com>" — keep this off the alerts mailbox
# EMAIL_BROADCAST_DAILY_QUOTA=5000  # admin newsletter sends per UTC day
# NEWSLETTER_POSTAL_ADDRESS=        # required to send newsletters (CAN-SPAM footer)
# EMAIL_DAILY_QUOTA_LIMIT=          # provider daily send cap
# EMAIL_DAILY_VERIFICATION_RESERVE= # part of the cap kept for verification mail
# EMAIL_FOLLOWED_ARTICLE_ENABLED=false

# Public API URL used for browser handoff and the hosted MCP (HTTPS, including /v1, in production).
# BROWSER_HANDOFF_BASE_URL=http://localhost:3001/v1

# Hosted MCP: read-only tool calls per Premium member per UTC day. Admins are not counted.
# MCP_MEMBER_DAILY_CALLS=200

# Background queues and database connection.
# SIDE_EFFECTS_QUEUE_CONCURRENCY=12
# PRISMA_CONNECT_RETRIES=20
# PRISMA_CONNECT_RETRY_DELAY_MS=500
# PRISMA_LOG_SLOW_QUERIES=
# PRISMA_SLOW_QUERY_MS=200

# App Store review sign-in (fixed phone + code for the reviewer account).
# APP_REVIEW_PHONE=
# APP_REVIEW_CODE=

# Apple in-app purchases (App Store Server API).
# APPLE_IAP_BUNDLE_ID=
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_KEY_ID=
# APPLE_IAP_PRIVATE_KEY=
# APPLE_IAP_PRODUCT_TIER_MAP=
# APPLE_IAP_ENVIRONMENT=sandbox     # or production
# APPLE_IAP_APP_APPLE_ID=

# Strava integration.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_WEBHOOK_VERIFY_TOKEN=

# Daily scripture translation.
# SCRIPTURE_TRANSLATION=

# SEC ticker list for cashtags (defaults to the SEC company tickers file).
# SEC_TICKERS_URL=
# SEC_TICKERS_USER_AGENT=

# Ops alerts and product analytics.
# SLACK_WEBHOOK_URL=
# POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# OpenAI (Marv and admin assistant). Models default to the constants in the Marv config.
# OPENAI_API_KEY=
# OPENAI_MARV_FAST_MODEL=
# OPENAI_MARV_REGULAR_MODEL=
# OPENAI_MARV_SMART_MODEL=
# OPENAI_ADMIN_ASTRA_MODEL=
# OPENAI_MARV_PROMPT_ID=
# OPENAI_MARV_PROMPT_VERSION=

# Marv identity.
# MARV_ENABLED=true
# MARV_USER_ID=
# MARV_USERNAME=marv
# MARV_DISPLAY_NAME=Marv
# MARV_BIO=
# MARV_PHONE=+10000000001

# Marv tools.
# MARV_WEB_SEARCH_ENABLED=true
# MARV_WEB_SEARCH_MODES=regular,smart
# MARV_WEB_SEARCH_MAX_OUTPUT_TOKENS=4096
# MARV_VISION_ENABLED=true
# MARV_VISION_MODES=fast,regular,smart
# MARV_VISION_MAX_IMAGES_PER_TURN=16

# Marv credits and costs.
# MARV_MONTHLY_CREDITS=600
# MARV_MAX_CREDITS=600
# MARV_CREDITS_PER_DAY=20
# MARV_FAST_COST=1
# MARV_REGULAR_COST=2
# MARV_SMART_COST=5
# MARV_WEB_SEARCH_CREDIT_COST=5
# MARV_VISION_CREDIT_COST_PER_IMAGE=1
# MARV_URL_FETCH_CREDIT_COST=1

# Marv limits.
# MARV_PUBLIC_MAX_INPUT_TOKENS=8000
# MARV_PRIVATE_MAX_INPUT_TOKENS=4000
# MARV_MAX_OUTPUT_TOKENS=4096
# MARV_PUBLIC_MAX_PER_USER_PER_HOUR=10
# MARV_PUBLIC_MAX_PER_USER_PER_DAY=30
# MARV_PUBLIC_THREAD_BURST_LIMIT=3
# MARV_PUBLIC_THREAD_BURST_WINDOW_SECONDS=60
# MARV_PRIVATE_MAX_PER_USER_PER_DAY=60
# MARV_PRIVATE_MAX_PER_10_MIN=10
# MARV_QUEUE_CONCURRENCY=8

