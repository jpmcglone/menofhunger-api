  "info": {
    "title": "Men of Hunger Partner API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "partner": {
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "type": "http"
      }
    },
    "schemas": {
      "PartnerContinuationDto": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 600
          }
        },
        "required": [
          "url",
          "expiresIn"
        ]
      },
      "PartnerPaginationDto": {
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "nextCursor"
        ]
      },
      "PartnerProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "canonicalUrl": {
            "type": "string"
          },
          "accountKind": {
            "type": "string",
            "enum": [
              "person",
              "page"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "counts": {
            "type": "object",
            "properties": {
              "followers": {
                "type": "integer"
              },
              "following": {
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "id",
          "username",
          "name",
          "bio",
          "avatarUrl",
          "canonicalUrl",
          "accountKind",
          "createdAt"
        ]
      },
      "PartnerVerificationDto": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "none",
              "manual",
              "identity"
            ]
          },
          "verifiedAt": {
            "type": "string",
            "nullable": true
          },
          "checkedAt": {
            "type": "string"
          }
        },
        "required": [
          "accountId",
          "status",
          "verifiedAt",
          "checkedAt"
        ]
      },
      "PartnerSourceDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "url"
        ]
      },
      "PartnerEngagementDto": {
        "type": "object",
        "properties": {
          "boosts": {
            "type": "number",
            "description": "Visible boosts from permitted, non-banned accounts."
          },
          "comments": {
            "type": "number",
            "description": "Visible direct replies for posts, visible comments for articles."
          },
          "uniqueViewers": {
            "type": "number",
            "description": "Recorded distinct signed-in viewers, filtered for permitted accounts; not reach."
          },
          "reactions": {
            "type": "number",
            "description": "Visible article reaction records; a member can use multiple reactions."
          }
        },
        "required": [
          "boosts",
          "comments",
          "uniqueViewers"
        ]
      },
      "PartnerMediaDto": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "nullable": true
          },
          "alt": {
            "type": "string",
            "nullable": true
          },
          "width": {
            "type": "number",
            "nullable": true
          },
          "height": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "kind",
          "url",
          "alt",
          "width",
          "height"
        ]
      },
      "PartnerContentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "post",
              "article"
            ]
          },
          "canonicalUrl": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "published"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "editedAt": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string"
          },
          "bodyFormat": {
            "type": "string",
            "enum": [
              "text",
              "html"
            ]
          },
          "publishedAt": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/PartnerSourceDto"
          },
          "engagement": {
            "$ref": "#/components/schemas/PartnerEngagementDto"
          },
          "title": {
            "type": "string"
          },
          "excerpt": {
            "type": "object",
            "nullable": true
          },
          "author": {
            "$ref": "#/components/schemas/PartnerProfileDto"
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PartnerMediaDto"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "canonicalUrl",
          "status",
          "createdAt",
          "editedAt",
          "body",
          "bodyFormat",
          "publishedAt",
          "source",
          "author",
          "media"
        ]
      },
      "PartnerArticleCommentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "articleId": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string"
          },
          "bodyFormat": {
            "type": "string",
            "enum": [
              "text"
            ]
          },
          "canonicalUrl": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "published"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "editedAt": {
            "type": "string",
            "nullable": true
          },
          "author": {
            "$ref": "#/components/schemas/PartnerProfileDto"
          }
        },
        "required": [
          "id",
          "articleId",
          "parentId",
          "body",
          "bodyFormat",
          "canonicalUrl",
          "status",
          "createdAt",
          "editedAt",
          "author"
        ]
      }
    }
  }
}
